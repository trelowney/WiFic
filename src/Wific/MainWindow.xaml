<Window x:Class="Wific.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Wific"
        xmlns:controls="clr-namespace:Wific.Controls"
        xmlns:vm="clr-namespace:Wific.ViewModels"
        Title="wific – Wi-Fi scanner"
        Width="1440" Height="860" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextMain}"
        FontFamily="Segoe UI" FontSize="13"
        Topmost="{Binding AlwaysOnTop}"
        Icon="/Assets/wific.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:RssiToBrushConverter x:Key="RssiBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="8" />
            <RowDefinition Height="320" MinHeight="180" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,14,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="34" Height="34" CornerRadius="9">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4F8CFF" Offset="0" />
                            <GradientStop Color="#8A5CFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Path Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,3,0,0"
                          Data="M0,6 A11,11 0 0 1 18,6 M3.5,9.5 A6.5,6.5 0 0 1 14.5,9.5 M7,13 A2.5,2.5 0 0 1 11,13" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="wific" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Wi-Fi scanner · 2.4 / 5 / 6 GHz" FontSize="11.5" Foreground="{StaticResource TextMuted}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="32,0,16,0">
                <ComboBox Width="250" ItemsSource="{Binding Interfaces}" SelectedItem="{Binding SelectedInterface}"
                          ToolTip="Wi-Fi adapter used for scanning" Margin="0,0,14,0" />
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Show24}" ToolTip="Show 2.4 GHz networks">
                    <TextBlock><Run Text="2.4 GHz" /><Run Text="  " /><Run Text="{Binding Count24, Mode=OneWay}" Foreground="{StaticResource TextMuted}" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Show5}" ToolTip="Show 5 GHz networks">
                    <TextBlock><Run Text="5 GHz" /><Run Text="  " /><Run Text="{Binding Count5, Mode=OneWay}" Foreground="{StaticResource TextMuted}" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding Show6}" ToolTip="Show 6 GHz networks (requires a Wi-Fi 6E / 7 adapter)">
                    <TextBlock><Run Text="6 GHz" /><Run Text="  " /><Run Text="{Binding Count6, Mode=OneWay}" Foreground="{StaticResource TextMuted}" /></TextBlock>
                </ToggleButton>
                <ToggleButton Style="{StaticResource Chip}" IsChecked="{Binding HideStale}" Content="Hide inactive"
                              ToolTip="Hide networks that were not seen in the last scan" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox Style="{StaticResource SearchBox}" Width="220" Tag="Search SSID, BSSID, vendor…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                <ComboBox Width="78" ItemsSource="{Binding Intervals}" SelectedItem="{Binding ScanInterval}"
                          ItemStringFormat="{}{0} s" ToolTip="Scan interval" Margin="0,0,8,0" />
                <Button Content="{Binding ScanButtonText}" Command="{Binding ToggleScanCommand}" Width="84" Margin="0,0,8,0" />
                <Button Content="Export CSV" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                <Button Click="OnSettingsClick" ToolTip="Settings and about" Width="36" Padding="0">
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{StaticResource TextMain}"
                          Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Update banner -->
        <Border Grid.Row="1" Margin="20,0,20,10" Padding="14,10" CornerRadius="8" Background="#16264A" BorderBrush="#2F4F8F" BorderThickness="1"
                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding UpdateText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding UpdateMessage}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,2,0,0" />
                    <ProgressBar Style="{StaticResource SignalBar}" Width="260" HorizontalAlignment="Left" Margin="0,6,0,0"
                                 Foreground="{StaticResource Accent}" Value="{Binding UpdateProgress, Mode=OneWay}"
                                 Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource AccentButton}" Content="Update now" Command="{Binding InstallUpdateCommand}" Margin="0,0,8,0" />
                    <Button Content="What's new" Click="OnReleaseNotesClick" Margin="0,0,8,0" />
                    <Button Content="Skip this version" Command="{Binding SkipUpdateCommand}" Margin="0,0,8,0" />
                    <Button Content="Later" Command="{Binding DismissUpdateCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error banner -->
        <Border Grid.Row="2" Margin="20,0,20,10" Padding="14,10" CornerRadius="8" Background="#36181E" BorderBrush="#6B2C36" BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Open location settings" Command="{Binding OpenLocationSettingsCommand}" Margin="12,0,0,0"
                        Visibility="{Binding LocationProblem, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <!-- Network table -->
        <Border Grid.Row="3" Margin="20,0,20,0" Style="{StaticResource Card}" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding View}" SelectedItem="{Binding SelectedAccessPoint, Mode=TwoWay}">
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#151922" />
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Signal" SortMemberPath="Rssi" Width="118">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:AccessPointViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <ProgressBar Style="{StaticResource SignalBar}" Value="{Binding SignalPercent, Mode=OneWay}"
                                                 Foreground="{Binding Rssi, Converter={StaticResource RssiBrush}}" />
                                    <TextBlock Margin="8,0,0,0" Foreground="{Binding Rssi, Converter={StaticResource RssiBrush}}" FontWeight="SemiBold">
                                        <Run Text="{Binding Rssi, Mode=OneWay}" /><Run Text=" dBm" FontWeight="Normal" FontSize="11" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="SSID" SortMemberPath="Ssid" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type vm:AccessPointViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Brush}" Margin="0,0,8,0" />
                                    <TextBlock x:Name="SsidText" Text="{Binding Ssid, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="#1D3B2C"
                                            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="connected" FontSize="10.5" Foreground="#3DD68C" />
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter TargetName="SsidText" Property="FontStyle" Value="Italic" />
                                        <Setter TargetName="SsidText" Property="Foreground" Value="{StaticResource TextMuted}" />
                                        <Setter TargetName="SsidText" Property="FontWeight" Value="Normal" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="BSSID" Binding="{Binding Bssid, Mode=OneWay}" Width="138">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                <Setter Property="FontSize" Value="12" />
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Vendor" Binding="{Binding VendorText, Mode=OneWay}" SortMemberPath="Vendor" Width="170" />
                    <DataGridTextColumn Header="Band" Binding="{Binding BandText, Mode=OneWay}" SortMemberPath="FrequencyMhz" Width="70" />
                    <DataGridTextColumn Header="Channel" Binding="{Binding ChannelText, Mode=OneWay}" SortMemberPath="Channel" Width="78" />
                    <DataGridTextColumn Header="Width" Binding="{Binding WidthText, Mode=OneWay}" SortMemberPath="ChannelWidthMhz" Width="80" />
                    <DataGridTextColumn Header="Standard" Binding="{Binding StandardText, Mode=OneWay}" SortMemberPath="Protocol" Width="118" />
                    <DataGridTextColumn Header="Security" Binding="{Binding Security, Mode=OneWay}" Width="150" />
                    <DataGridTextColumn Header="Max rate" Binding="{Binding MaxRateText, Mode=OneWay}" SortMemberPath="MaxRateMbps" Width="90" />
                    <DataGridTextColumn Header="Clients" Binding="{Binding StationCountText, Mode=OneWay}" SortMemberPath="StationCountSort" Width="66" />
                    <DataGridTextColumn Header="Ch. load" Binding="{Binding UtilizationText, Mode=OneWay}" SortMemberPath="UtilizationSort" Width="72" />
                    <DataGridTextColumn Header="AP uptime" Binding="{Binding UptimeText, Mode=OneWay}" SortMemberPath="UptimeSort" Width="104" />
                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenText, Mode=OneWay}" SortMemberPath="LastSeen" Width="84" />
                    <DataGridTextColumn Header="Country" Binding="{Binding Country, Mode=OneWay}" Width="64" />
                    <DataGridTextColumn Header="Device" Binding="{Binding Device, Mode=OneWay}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Rows" Cursor="SizeNS" />

        <!-- Graphs and details -->
        <Border Grid.Row="5" Margin="20,0,20,0" Style="{StaticResource Card}" ClipToBounds="True">
            <TabControl>
                <TabItem Header="Channels 2.4 GHz">
                    <controls:ChannelGraph Band="Band2_4" Items="{Binding View}" Selected="{Binding SelectedAccessPoint}" Revision="{Binding Revision}" />
                </TabItem>
                <TabItem Header="Channels 5 GHz">
                    <controls:ChannelGraph Band="Band5" Items="{Binding View}" Selected="{Binding SelectedAccessPoint}" Revision="{Binding Revision}" />
                </TabItem>
                <TabItem Header="Channels 6 GHz">
                    <controls:ChannelGraph Band="Band6" Items="{Binding View}" Selected="{Binding SelectedAccessPoint}" Revision="{Binding Revision}" />
                </TabItem>
                <TabItem Header="Signal history">
                    <controls:SignalHistoryGraph Items="{Binding View}" Selected="{Binding SelectedAccessPoint}" Revision="{Binding Revision}" />
                </TabItem>
                <TabItem Header="Details">
                    <Grid>
                        <TextBlock Text="Select a network in the table to see its details."
                                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid DataContext="{Binding SelectedAccessPoint}" Background="{StaticResource Surface}"
                              Visibility="{Binding DataContext.SelectedAccessPoint, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Static local:NullToVisibilityConverter.Instance}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="460" />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,6,6">
                                <WrapPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="SSID" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Ssid, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="BSSID" /><TextBlock Style="{StaticResource FieldValue}" FontFamily="{StaticResource MonoFont}" Text="{Binding Bssid, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Vendor" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding VendorText, Mode=OneWay}" ToolTip="{Binding VendorText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Signal" /><TextBlock Style="{StaticResource FieldValue}"><Run Text="{Binding Rssi, Mode=OneWay}" /><Run Text=" dBm · " /><Run Text="{Binding LinkQuality, Mode=OneWay}" /><Run Text=" %" /></TextBlock></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Frequency" /><TextBlock Style="{StaticResource FieldValue}"><Run Text="{Binding FrequencyMhz, Mode=OneWay}" /><Run Text=" MHz · " /><Run Text="{Binding BandText, Mode=OneWay}" /></TextBlock></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Channel (center)" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding ChannelText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Channel width" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding WidthText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Standard" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding StandardText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Max PHY rate" /><TextBlock Style="{StaticResource FieldValue}"><Run Text="{Binding MaxRateText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SpatialStreams, Mode=OneWay}" /><Run Text="×SS" /></TextBlock></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Security" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Security, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Ciphers" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Ciphers, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Protected mgmt frames" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Pmf, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="AP uptime" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding UptimeText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Clients / channel load" /><TextBlock Style="{StaticResource FieldValue}"><Run Text="{Binding StationCountText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UtilizationText, Mode=OneWay}" /></TextBlock></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Beacon interval" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding BeaconText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Fast roaming" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Roaming, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="BSS color" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding BssColorText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Multi-link (Wi-Fi 7)" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding MultiLinkText, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}"><TextBlock Style="{StaticResource FieldLabel}" Text="Country" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Country, Mode=OneWay}" /></StackPanel>
                                    <StackPanel Style="{StaticResource Field}" Width="392"><TextBlock Style="{StaticResource FieldLabel}" Text="Device (WPS / AP name)" /><TextBlock Style="{StaticResource FieldValue}" Text="{Binding Device, Mode=OneWay}" ToolTip="{Binding Device, Mode=OneWay}" /></StackPanel>
                                </WrapPanel>
                            </ScrollViewer>
                            <Border Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="INFORMATION ELEMENTS" Style="{StaticResource SectionTitle}" Margin="14,12,0,6" />
                                    <DataGrid ItemsSource="{Binding Elements, Mode=OneWay}" RowHeight="26" ColumnHeaderHeight="30" FontSize="12">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="ID" Binding="{Binding IdText, Mode=OneWay}" Width="60" />
                                            <DataGridTextColumn Header="Element" Binding="{Binding Name, Mode=OneWay}" Width="170" />
                                            <DataGridTextColumn Header="Len" Binding="{Binding Length, Mode=OneWay}" Width="44" />
                                            <DataGridTextColumn Header="Data" Binding="{Binding Hex, Mode=OneWay}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                        <Setter Property="FontSize" Value="11" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="6" Margin="22,8,22,10">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMuted}" FontSize="12" />
            <TextBlock HorizontalAlignment="Right" Foreground="{StaticResource TextMuted}" FontSize="12">
                <Run Text="Vendor DB: " /><Run Text="{Binding OuiCount, Mode=OneWay, StringFormat={}{0:N0}}" /><Run Text=" prefixes  ·  v" /><Run Text="{Binding AppVersion, Mode=OneWay}" />
            </TextBlock>
        </Grid>
    </Grid>
</Window>
