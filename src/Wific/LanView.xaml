<UserControl x:Class="Wific.LanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Wific"
             xmlns:controls="clr-namespace:Wific.Controls"
             xmlns:vm="clr-namespace:Wific.ViewModels">
    <UserControl.Resources>
        <local:SeverityToBrushConverter x:Key="SeverityBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="6" />
            <RowDefinition Height="250" MinHeight="140" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Margin="16,0,16,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding SummaryText}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" Margin="12,0,0,0" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Range" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" />
                <TextBox Style="{StaticResource SearchBox}" Width="300" Tag="e.g. 192.168.1.0/24 or 10.0.0.1-50"
                         Text="{Binding RangeText, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnRangeKeyDown"
                         ToolTip="Networks (192.168.1.0/24), ranges (10.0.0.1-10.0.0.50 or 10.0.0.1-50) or addresses, separated by commas. Up to 65,536 addresses." />
                <Button Style="{StaticResource AccentButton}" Content="{Binding ScanButtonText}" Command="{Binding ScanCommand}"
                        Width="84" Margin="8,0,0,0" />
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Identify}" Margin="18,0,0,0" VerticalAlignment="Center"
                          Content="Check ports and identify devices"
                          ToolTip="Checks common ports (web, SMB, RDP, SSH, printers, cameras…) and asks each device for its name and model (DNS, NetBIOS, mDNS, SMB, UPnP, web page). Turn off for a quick ping-only scan." />
            </StackPanel>
        </DockPanel>

        <!-- Network and progress -->
        <Grid Grid.Row="1" Margin="18,0,18,8">
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"
                       Margin="0,0,420,0" />
            <TextBlock Text="{Binding NetworkText}" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Right"
                       TextTrimming="CharacterEllipsis" MaxWidth="410" />
            <ProgressBar Height="2" VerticalAlignment="Bottom" Margin="0,0,0,-5" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Accent}"
                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Devices -->
        <Border Grid.Row="2" Margin="16,0,16,0" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="DeviceGrid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                          MinColumnWidth="40" controls:ColumnFit.Enabled="True">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="Transparent" />
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="!" SortMemberPath="IssueSeverity" Width="34" MinWidth="34" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:LanDevice}">
                                    <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Center"
                                            Background="{Binding IssueSeverity, Converter={StaticResource SeverityBrush}}"
                                            Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}"
                                            ToolTip="{Binding IssueTooltip}">
                                        <TextBlock Text="{Binding IssueSymbol}" Foreground="White" FontSize="11" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="IP address" Binding="{Binding IpText, Mode=OneWay}" SortMemberPath="IpSort"
                                            Width="118" MinWidth="118" controls:ColumnFit.Weight="0" />
                        <DataGridTemplateColumn Header="Name" SortMemberPath="Name" Width="190" MinWidth="190" controls:ColumnFit.Weight="3">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:LanDevice}">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Margin="6,0,0,0" Padding="5,0" CornerRadius="4" VerticalAlignment="Center"
                                                Background="{DynamicResource AccentSoft}"
                                                Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="new" FontSize="10.5" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                        <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding TypeText, Mode=OneWay}" Width="150" MinWidth="150" controls:ColumnFit.Weight="1" />
                        <DataGridTextColumn Header="Vendor" Binding="{Binding VendorText, Mode=OneWay}" Width="190" MinWidth="190" controls:ColumnFit.Weight="2" />
                        <DataGridTextColumn Header="MAC address" Binding="{Binding MacText, Mode=OneWay}" Width="148" MinWidth="148" controls:ColumnFit.Weight="0">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ping" Binding="{Binding PingText, Mode=OneWay}" SortMemberPath="PingSort"
                                            Width="70" MinWidth="70" controls:ColumnFit.Weight="0" />
                        <DataGridTextColumn Header="Services" Binding="{Binding ServicesText, Mode=OneWay}" Width="190" MinWidth="190" controls:ColumnFit.Weight="2" />
                        <DataGridTextColumn Header="Model / system" Binding="{Binding InfoText, Mode=OneWay}" Width="190" MinWidth="190" controls:ColumnFit.Weight="3" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"
                      ResizeDirection="Rows" Cursor="SizeNS" />

        <!-- Details of the selected device -->
        <Border Grid.Row="4" Margin="16,0,16,0" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <TextBlock Text="Select a device to see everything wific found out about it." HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"
                           Visibility="{Binding Selected, Converter={x:Static local:NullToVisibilityConverter.Instance}, ConverterParameter=invert}" />
                <Grid DataContext="{Binding Selected}" Margin="16,12"
                      Visibility="{Binding Converter={x:Static local:NullToVisibilityConverter.Instance}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="380" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Details}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LanDetail}">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextMuted}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Web interface" Style="{StaticResource SectionTitle}"
                                   Visibility="{Binding WebLinks.Count, Converter={x:Static local:CountToVisibilityConverter.Instance}}" />
                        <ItemsControl ItemsSource="{Binding WebLinks}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LanPort}">
                                    <Button Content="{Binding Url}" Tag="{Binding Url}" Click="OnOpenLink" Margin="0,0,8,8"
                                            ToolTip="Open in your browser" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Security" Style="{StaticResource SectionTitle}"
                                   Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:Issue}">
                                    <DockPanel Margin="0,0,0,6">
                                        <Ellipse DockPanel.Dock="Left" Width="9" Height="9" Margin="0,4,8,0" VerticalAlignment="Top"
                                                 Fill="{Binding Severity, Converter={StaticResource SeverityBrush}}" />
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
