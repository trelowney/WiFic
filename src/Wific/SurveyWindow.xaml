<Window x:Class="Wific.SurveyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="wific – Site survey"
        Width="1200" Height="800" MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource TextMain}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="/Assets/wific.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Margin="16,12,16,10">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="Floor plan…" Click="OnLoadPlanClick" Margin="0,0,8,0" ToolTip="Load a floor plan image (PNG, JPG, BMP)" />
                <Button Content="Blank canvas" Click="OnBlankClick" Margin="0,0,8,0" ToolTip="Survey without a floor plan" />
                <Button Content="Open…" Click="OnOpenClick" Margin="0,0,8,0" />
                <Button Content="Save…" Click="OnSaveClick" Margin="0,0,8,0" x:Name="SaveButton" />
                <Button Content="Export PNG…" Click="OnExportClick" Margin="0,0,8,0" x:Name="ExportButton" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="Show" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0" />
                <ComboBox x:Name="TargetBox" Width="240" SelectionChanged="OnTargetChanged" Margin="0,0,8,0" />
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource Segment}" GroupName="SurveyBand" Content="All" IsChecked="True" Tag="-1" Checked="OnBandChecked" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="SurveyBand" Content="2.4" Tag="0" Checked="OnBandChecked" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="SurveyBand" Content="5" Tag="1" Checked="OnBandChecked" />
                        <RadioButton Style="{StaticResource Segment}" GroupName="SurveyBand" Content="6 GHz" Tag="2" Checked="OnBandChecked" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Grid />
        </DockPanel>

        <!-- Plan -->
        <Border Grid.Row="1" Margin="16,0,16,0" Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="Site survey" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,16">
                        Load a floor plan (or use a blank canvas), walk around and click the spot where you are standing.
                        wific measures there for about 4 seconds. The more points you take, the more accurate the heatmap.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Load floor plan…" Style="{StaticResource AccentButton}" Click="OnLoadPlanClick" Margin="0,0,8,0" />
                        <Button Content="Blank canvas" Click="OnBlankClick" Margin="0,0,8,0" />
                        <Button Content="Open survey…" Click="OnOpenClick" />
                    </StackPanel>
                </StackPanel>

                <Viewbox x:Name="PlanViewbox" Stretch="Uniform" Margin="12" Visibility="Collapsed">
                    <Grid x:Name="PlanGrid" Background="White" Cursor="Cross"
                          MouseLeftButtonUp="OnPlanLeftClick" MouseRightButtonUp="OnPlanRightClick">
                        <Image x:Name="PlanImage" Stretch="Fill" />
                        <Image x:Name="HeatImage" Stretch="Fill" Opacity="0.62" RenderOptions.BitmapScalingMode="HighQuality" IsHitTestVisible="False" />
                        <Canvas x:Name="Markers" IsHitTestVisible="False" />
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- Legend and status -->
        <DockPanel Grid.Row="2" Margin="18,8,18,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="-30 dBm" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" />
                <Border x:Name="LegendBar" Width="220" Height="10" CornerRadius="5" Margin="8,0" />
                <TextBlock Text="-95 dBm" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="Click on the plan where you stand to take a measurement. Right-click a point to delete it." />
        </DockPanel>
    </Grid>
</Window>
